# ---------------------------------------------------------------------------
# AutoHous Revenue Engine - exemplo de configuracao.
# Copie para .env e preencha. NUNCA commitar o .env (ver docs/governance.md).
# ---------------------------------------------------------------------------

# Postgres local (docker compose up -d db)
#
# As aspas nao sao enfeite: a string tem ponto-e-virgula, e `set -a; . ./.env`
# sem elas atribui apenas Host=localhost e executa Port=5433 como comando. O
# sintoma e um erro de autenticacao do Postgres que nao menciona o .env.
REVENUE_DB_CONNECTION="Host=localhost;Port=5433;Database=autohous_revenue;Username=revenue;Password=revenue"

# Testes de integracao. Vazia = cada classe sobe um Postgres efemero proprio via
# Testcontainers, que e o padrao. Preenchida, cada classe passa a criar - e
# destruir - um banco proprio dentro de um servidor que ja esta de pe, o do
# compose acima. Serve para ambiente onde o Testcontainers nao roda com o Docker
# saudavel do lado: sob o Smart App Control do Windows, por exemplo, o
# Docker.DotNet.dll e bloqueado no load e a bateria falha inteira antes do
# primeiro teste. O nome do banco e ignorado - cada classe gera o seu.
REVENUE_TEST_DB_CONNECTION=

# Runtime de agente: "fixture" (deterministico, sem custo) ou "hermes" (real)
AGENT_RUNTIME=fixture

# Hermes API Server (apenas quando AGENT_RUNTIME=hermes)
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_SERVER_KEY=

# Diretorio dos fixtures usados por AGENT_RUNTIME=fixture
AGENT_FIXTURE_DIR=tests/fixtures/agent-runs

# Dados Abertos CNPJ da Receita Federal.
# O token do compartilhamento e descoberto do redirect da raiz do site; so
# preencha se a descoberta falhar (a Receita ja trocou de plataforma uma vez).
RECEITA_SHARE_TOKEN=
# Onde os zips do release ficam. Reexecutar a carga nao rebaixa o que ja esta integro.
RECEITA_CACHE_DIR=.receita-cache

# Supabase (somente a partir do HML - nao usar em dev local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Credencial de borda da Revenue API (ADR-0009). Sem ela a API NAO SOBE.
#   openssl rand -hex 24
# Varias chaves separadas por virgula convivem, para rotacionar sem derrubar
# o consumidor: REVENUE_API_KEY=nova,antiga
REVENUE_API_KEY=

# Alternativa preferida em HML/PRD: um arquivo com a chave, no formato que
# Docker secret e Kubernetes montam. Tem precedencia sobre a variavel acima.
REVENUE_API_KEY_FILE=

# Portas
REVENUE_API_URL=http://localhost:5080
